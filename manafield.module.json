{
  "id": "manafield-noctemblith",
  "name": "Manafield Noctemblith Adapter",
  "description": "Read-only readiness adapter for Noctemblith and Manafield Account Core; Noctemblith DB remains independently owned.",
  "version": "0.1.0",
  "healthOperation": "health",
  "operations": [
    {
      "id": "health",
      "description": "Checks Noctemblith and Manafield Account Core readiness, including the Account database binding.",
      "input": null,
      "output": {
        "type": "object",
        "required": [
          "status",
          "service",
          "version",
          "noctemblithReady",
          "accountCoreReady",
          "accountDatabaseReady"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "noctemblithReady": {
            "type": "boolean"
          },
          "accountCoreReady": {
            "type": "boolean"
          },
          "accountDatabaseReady": {
            "type": "boolean"
          }
        }
      },
      "binding": {
        "type": "http",
        "method": "GET",
        "path": "/manafield/health",
        "codecs": [
          "json"
        ]
      }
    },
    {
      "id": "status",
      "description": "Returns the non-sensitive readiness status of Noctemblith and its Account dependency.",
      "input": null,
      "output": {
        "type": "object",
        "required": [
          "status",
          "service",
          "version",
          "noctemblithReady",
          "accountCoreReady",
          "accountDatabaseReady"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "noctemblithReady": {
            "type": "boolean"
          },
          "accountCoreReady": {
            "type": "boolean"
          },
          "accountDatabaseReady": {
            "type": "boolean"
          }
        }
      },
      "binding": {
        "type": "http",
        "method": "GET",
        "path": "/manafield/noctemblith/status",
        "codecs": [
          "json"
        ]
      }
    }
  ]
}
